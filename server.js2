import express from "express";
import multer from "multer";
import cors from "cors";
import sqlite3 from "sqlite3";
import path from "path";
import { fileURLToPath } from "url";
import fs from "fs";

// ------------------ CONFIGURAÇÕES BÁSICAS ------------------

// Permite usar __dirname em módulos ES
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = 3000;

// Middlewares
app.use(cors());
app.use(express.json());
app.use(express.static("public"));

// ------------------ CONFIGURAÇÃO DO BANCO DE DADOS ------------------
const dbFile = path.join(__dirname, "banco.db");
const db = new sqlite3.Database(dbFile);

// Cria a tabela se não existir
db.run(`
  CREATE TABLE IF NOT EXISTS candidatos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    indicador TEXT NOT NULL,
    candidato TEXT NOT NULL,
    cpf TEXT NOT NULL UNIQUE,
    nascimento TEXT NOT NULL,
    curriculo TEXT NOT NULL,
    laudo TEXT NOT NULL,
    historico TEXT NOT NULL,
    data_envio TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  )
`);

// ------------------ CONFIGURAÇÃO DE UPLOADS ------------------
const uploadDir = path.join(__dirname, "uploads");

// Cria a pasta uploads se não existir
if (!fs.existsSync(uploadDir)) {
  fs.mkdirSync(uploadDir);
}

const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    cb(null, uploadDir);
  },
  filename: (req, file, cb) => {
    const uniqueSuffix = Date.now() + "-" + Math.round(Math.random() * 1e9);
    cb(null, uniqueSuffix + "-" + file.originalname);
  },
});

const upload = multer({
  storage,
  limits: { fileSize: 5 * 1024 * 1024 }, // 5 MB
});

// ------------------ ROTAS ------------------

// Rota principal (HTML)
app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "index.html"));
});

// Rota de envio do formulário
app.post(
  "/enviar",
  upload.fields([
    { name: "curriculo", maxCount: 1 },
    { name: "laudo", maxCount: 1 },
    { name: "historico", maxCount: 1 },
  ]),
  (req, res) => {
    const { indicador, candidato, cpf, nascimento } = req.body;
    const curriculo = req.files["curriculo"][0].filename;
    const laudo = req.files["laudo"][0].filename;
    const historico = req.files["historico"][0].filename;

    if (!indicador || !candidato || !cpf || !nascimento) {
      return res.status(400).json({ error: "Preencha todos os campos obrigatórios." });
    }

    const sql = `
      INSERT INTO candidatos (indicador, candidato, cpf, nascimento, curriculo, laudo, historico)
      VALUES (?, ?, ?, ?, ?, ?, ?)
    `;

    db.run(sql, [indicador, candidato, cpf, nascimento, curriculo, laudo, historico], function (err) {
      if (err) {
        console.error("Erro ao inserir no banco:", err.message);
        return res.status(500).json({ error: "Erro ao salvar no banco de dados." });
      }
      res.status(200).json({ success: true, message: "Candidato cadastrado com sucesso!" });
    });
  }
);

// ------------------ INICIAR SERVIDOR ------------------
app.listen(PORT, () => {
  console.log(`✅ Servidor rodando em http://localhost:${PORT}`);
});
