const http = require('http');
const fs = require('fs');
const path = require('path');
const querystring = require('querystring');

const PORT = 3000;
const DB_FILE = path.join(__dirname, 'banco.db');

function salvarDados(dados) {
  const linha = `${new Date().toLocaleString()} | Indicador: ${dados.indicador} | Candidato: ${dados.candidato} | CPF: ${dados.cpf} | Nascimento: ${dados.nascimento}\n`;
  fs.appendFileSync(DB_FILE, linha, 'utf8');
}

const server = http.createServer((req, res) => {
  if (req.url === '/' && req.method === 'GET') {
    const html = fs.readFileSync(path.join(__dirname, 'index.html'), 'utf8');
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    res.end(html);
  } else if (req.url === '/enviar' && req.method === 'POST') {
    let body = '';
    req.on('data', chunk => body += chunk.toString());
    req.on('end', () => {
      const dados = querystring.parse(body);

      const cpfValido = /^\d{11}$/.test(dados.cpf);
      if (!cpfValido) {
        res.writeHead(400, { 'Content-Type': 'text/html; charset=utf-8' });
        res.end('<h3>CPF inválido. Digite apenas números com 11 dígitos.</h3><a href="/">Voltar</a>');
        return;
      }

      salvarDados(dados);
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(`<h2>Dados enviados com sucesso!</h2><a href="/">Voltar</a>`);
    });
  } else {
    res.writeHead(404, { 'Content-Type': 'text/plain' });
    res.end('Página não encontrada');
  }
});

server.listen(PORT, () => {
  console.log(`Servidor rodando em http://localhost:${PORT}`);
});
